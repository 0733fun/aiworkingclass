---
/**
 * 文章 / 指南 通用布局。
 *
 * 关键设计（依据是「AI 不引用页面，它捡句子」）：
 *  1. summary（可引用句）渲染成正文第一段，位于前 100 词内 —— 抽取器最先看这里
 *  2. 可见的「最后更新」日期与结构化数据 dateModified 严格一致
 *     （两者一致 = 显得被维护；不一致 = 显得坏掉）
 *  3. 正文以纯文本形式输出，不使用任何 client 端渲染
 */
import { SITE } from '../site.config.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** 可被直接引用的一句话 */
  summary: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  /** 用于结构化数据判定文章类型 */
  section?: string;
  /** 指南页额外的 FAQ 结构化数据 */
  faqLd?: Array<Record<string, unknown>>;
  draft?: boolean;
}

const {
  title,
  description,
  summary,
  pubDate,
  updatedDate,
  tags = [],
  section = '文章',
  faqLd = [],
  draft = false,
} = Astro.props;

function fmt(d: Date): string {
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
  const day = String(d.getUTCDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const isUpdated = updatedDate && updatedDate.getTime() !== pubDate.getTime();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: title,
  description,
  /** 摘要作为 abstract 显式声明，AI 可以直接取用 */
  abstract: summary,
  url: canonical,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  inLanguage: SITE.lang,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  ...(section ? { articleSection: section } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={[articleLd, ...faqLd]}
  noindex={draft}
>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>发表于 <time datetime={fmt(pubDate)}>{fmt(pubDate)}</time></span>
        {
          isUpdated && (
            <span>
              最后更新{' '}
              <time datetime={fmt(updatedDate!)}>{fmt(updatedDate!)}</time>
            </span>
          )
        }
        <span>{SITE.author.name}</span>
      </div>

      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => (
              <li>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <!-- 可引用句：独立成立、含实体与具体信息，放在正文最前 -->
    <p class="lede">{summary}</p>

    <slot />
  </article>
</BaseLayout>
